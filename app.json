{
  "expo": {
    "name": "Playr",
    "slug": "playr",
    "version": "1.0.0",
    "platforms": ["ios"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "1",
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "./plugins/with-ios-scene-lifecycle"
    ],
    "icon": "./assets/icon.png"
  }
}
